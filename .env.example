# Copy this file to .env and fill in your own values. Never commit the real .env.

PORT=3000
NODE_ENV=development

# Long random string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=417aa9f9e75883ea02e6a7c0f1587d8f55f8ed8186a04f20ba0f0cd8960b8e1c

# Google Cloud Console -> APIs & Services -> Credentials
# Enable "YouTube Data API v3" first, then create an API key.
YOUTUBE_API_KEY=AIzaSyAuKWgV4Cy6Ysf_UULlZ47TPhukTJaIIyA
# Spotify Developer Dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=117ebf41a1ec4a2dbc6afbb1a958346c
SPOTIFY_CLIENT_SECRET=de54e6860e3b401581fcbeb6bf7bbd7e
# Must match a Redirect URI you added in the Spotify app settings exactly.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback


# Safety cap so one playlist can't burn your whole daily YouTube quota.
MAX_PLAYLIST_ITEMS=300
